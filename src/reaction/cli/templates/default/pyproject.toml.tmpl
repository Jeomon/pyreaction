[project]
name = "{{name}}"
version = "0.1.0"
description = "A pyreaction app"
readme = "README.md"
requires-python = ">=3.11"
dependencies = [
    "{{dependency}}",
]

# `uv run dev` and `uv run pro`. Add your own commands here too.
[project.scripts]
dev = "reaction.cli:dev"
pro = "reaction.cli:pro"

# Needed so uv installs the project, and with it the commands above.
[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
only-include = ["app.py", "components"]

[tool.pyreaction]
app = "app:App"
title = "{{name}}"
static = "public"
stylesheets = ["style.css"]
{{sources}}